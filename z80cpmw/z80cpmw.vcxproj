      <!-- C4267 six times, all the same shape: a size_t loop index promoting a
           uint16_t guest address (write_to_bank/read_from_bank(buffer + s * 512
           + i, ...)). Truncating to sixteen bits IS the Z80 64K address wrap
           HBIOS wants, so there is nothing to fix - and six permanent warnings
           in every build are how a real one comes to be ignored. Suppressed for
           this imported file only, as C4244 is for the four cpmemu ones. -->
      <DisableSpecificWarnings>4267;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
