    <ClCompile Include="MainWindow.cpp" />
    <ClCompile Include="TerminalView.cpp" />
    <ClCompile Include="EmulatorEngine.cpp" />
    <ClCompile Include="emu_io_windows.cpp" />
    <ClCompile Include="DiskCatalog.cpp" />
    <!-- NotUsing, and for a reason that is load-bearing rather than incidental:
         DiskLedger.cpp holds no Win32, no WinHTTP and no file system, which is
         the whole reason tests\test_diskledger.cpp can check its decisions on a
         machine with no data folder. Putting pch.h at the top to satisfy /Yu
         would make that false. -->
    <ClCompile Include="DiskLedger.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- NotUsing for the same reason again, and here it is the difference
         between a test and no test at all: CatalogV0.cpp reads the two
         interface-v0 catalog documents, and DiskCatalog.cpp - the only thing
         that fetches them - owns WinHTTP and a detached thread and can be
         linked by nothing. Holding no Win32, no WinHTTP and no threads is what
         lets tests\test_catalogv0.cpp drive it against the real published
         index and catalog. It is also what makes "the parse cannot throw"
         checkable, which matters because the parse it replaces called
         std::stoull on a served value with nothing to catch it. -->
    <ClCompile Include="CatalogV0.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- NotUsing for exactly the reason above, and it is the same argument one
         step on: DiskMigrationV0.cpp decides which files the interface-v0
         migration renames and what every stored path becomes, and getting that
         wrong loses a user's configured disk. It holds no Win32 and no file
         system so both tests\test_diskledger.cpp and tests\test_config.cpp can
         link it and check those decisions; pch.h at the top would end that. -->
    <ClCompile Include="DiskMigrationV0.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- NotUsing for the same reason, one step weaker: DiskHash.cpp does need
         windows.h and bcrypt.h, but not WinHTTP, not wx and not DiskCatalog.
         That is what lets the disk provenance suite link it and check a hash
         against a known vector - which nothing could do while these two
         functions were private statics on the class that owns the downloads. -->
    <ClCompile Include="DiskHash.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- NotUsing so the file can stay small. It includes windows.h,
         <algorithm>, <sstream>, <string>, <vector> and resource.h and nothing
         else, which is the property tests\test_help.cpp is built on; resource.h
         is a file of #define lines and pulls in nothing itself. Putting pch.h
         at the top to satisfy /Yu would silently add commdlg, shlobj, <thread>
         and <random> and make that claim false. The cost is one parse of
         windows.h that the other sources get from the PCH. SettingsDialogWx
         .cpp is NotUsing as well, for a reason this repository does not record;
         it includes pch.h itself, so whatever that reason is, it is not this
         one. -->
    <ClCompile Include="HelpAssets.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="HelpWindow.cpp" />
    <ClCompile Include="Dazzler.cpp" />
    <ClCompile Include="DazzlerWindow.cpp" />
    <ClCompile Include="Config.cpp">
