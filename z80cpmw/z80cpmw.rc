/*
 * z80cpmw.rc - Windows resource file
 */

#include "resource.h"
#include "Version.h"
#include <windows.h>

// Application Icon
IDI_APPICON ICON "z80cpmw.ico"

// The eight shared help assets, compiled in from the sibling ..\ioscpm
// checkout so that a reader with no network and an empty cache still gets the
// seven remote topics. help_assets::bundledTopic reads them back out.
//
// The paths are relative and resolved through the resource compiler's include
// path, which the vcxproj sets to $(SolutionDir).. in both configurations.
// Measured before this was written, because it is not what an include path
// obviously does: rc.exe searches /i for an RCDATA DATA FILE, not only for a
// #include, and without it reports "error RC2135: file not found:
// ioscpm\release_assets\help_index.json". A relative path was chosen over an
// absolute one so the .rc says nothing about where anybody's tree lives, and
// over a PreBuildEvent that generates a .rc because a generated file that has
// to exist before the resource compiler runs is a second build step to get
// wrong for no gain.
//
// BUNDLING IS OPTIONAL, and the #ifndef below is what makes it so. ..\cpmemu
// and ..\romwbw_emu are required siblings because they ARE the emulator - the
// vcxproj compiles their sources and nothing runs without them. ..\ioscpm
// supplies help TEXT only, and charging a hard RC2135 for it turned a checkout
// of z80cpmw + cpmemu + romwbw_emu, which was a complete build the day before,
// into one that does not build at all. A missing feature is the right price for
// a missing optional input; a stopped build is not.
//
// z80cpmw.vcxproj tests Exists() on
// $(SolutionDir)..\ioscpm\release_assets\help_index.json and defines
// NO_BUNDLED_HELP_ASSETS when it is not there. Nothing else changes: the
// bundled* readers in HelpAssets.cpp go through readModuleResource, which
// answers empty for a resource FindResourceW cannot find, and
// help_assets::resolveTopic already reads empty as "this build ships no copy".
// A build without ..\ioscpm therefore behaves exactly as every build did before
// bundling existed - download, then the on-disk cache, then the failure page -
// rather than failing to link or crashing on a missing id. The ids themselves
// live in resource.h unconditionally, so HelpAssets.cpp compiles either way.
//
// The sense is NEGATIVE - resources present by default, suppressed by a define
// - on purpose, and not because a positive HELP_BUNDLED_ASSETS would read
// better. rc.exe is run over this file from two places. The other is
// tests\run_tests.bat, which passes no /D at all and compiles the .rc only
// inside an "if exist ..\ioscpm\release_assets\help_index.json" block. Under a
// positive guard that invocation would quietly produce a .res with no help
// resources while the suite's own /D HELP_BUNDLED_ASSETS section went on
// asserting each blob is byte-identical to its file - a green precondition
// turned into a red suite by a rename. Under this sense that script needs no
// edit and keeps working unchanged.
#ifndef NO_BUNDLED_HELP_ASSETS
IDR_HELP_INDEX          RCDATA "ioscpm\\release_assets\\help_index.json"
IDR_HELP_QUICK_START    RCDATA "ioscpm\\release_assets\\help_quick_start.md"
IDR_HELP_CPM22          RCDATA "ioscpm\\release_assets\\help_cpm22.md"
IDR_HELP_ZSDOS          RCDATA "ioscpm\\release_assets\\help_zsdos.md"
IDR_HELP_NZCOM          RCDATA "ioscpm\\release_assets\\help_nzcom.md"
IDR_HELP_ZPM3           RCDATA "ioscpm\\release_assets\\help_zpm3.md"
IDR_HELP_QPM            RCDATA "ioscpm\\release_assets\\help_qpm.md"
IDR_HELP_FILE_TRANSFER  RCDATA "ioscpm\\release_assets\\help_file_transfer.md"
#endif

// Menu
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "Select &ROM"
        BEGIN
            MENUITEM "EMU AVW (Recommended)",   ID_ROM_EMU_AVW
            MENUITEM "EMU RomWBW",              ID_ROM_EMU_ROMWBW
        END
        MENUITEM SEPARATOR
        MENUITEM "Load Disk &0...",             ID_FILE_LOADDISK0
        MENUITEM "Load Disk &1...",             ID_FILE_LOADDISK1
        MENUITEM SEPARATOR
        MENUITEM "Save Disk 0...",              ID_FILE_SAVEDISK0
        MENUITEM "Save Disk 1...",              ID_FILE_SAVEDISK1
        MENUITEM "Save All Disks",              ID_FILE_SAVEDISKS
        MENUITEM SEPARATOR
        MENUITEM "Load &Profile...",            ID_FILE_LOADPROFILE
        MENUITEM "Save Profile &As...",         ID_FILE_SAVEPROFILE
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",               ID_FILE_EXIT
    END
    POPUP "&Emulator"
    BEGIN
        MENUITEM "&Start\tF5",                  ID_EMU_START
        MENUITEM "S&top\tShift+F5",             ID_EMU_STOP
        MENUITEM "&Reset",                      ID_EMU_RESET
        MENUITEM SEPARATOR
        MENUITEM "S&ettings...",                ID_EMU_SETTINGS
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Font Size 14",                ID_VIEW_FONT14
        MENUITEM "Font Size 16",                ID_VIEW_FONT16
        MENUITEM "Font Size 18",                ID_VIEW_FONT18
        MENUITEM "Font Size 20",                ID_VIEW_FONT20, CHECKED
        MENUITEM "Font Size 24",                ID_VIEW_FONT24
        MENUITEM "Font Size 28",                ID_VIEW_FONT28
        MENUITEM SEPARATOR
        MENUITEM "&Dazzler Window",             ID_VIEW_DAZZLER
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics\tF1",            ID_HELP_TOPICS
        MENUITEM SEPARATOR
        MENUITEM "&About z80cpmw...",           ID_HELP_ABOUT
    END
END

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_RC
PRODUCTVERSION VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "avwohl"
            VALUE "FileDescription", "Z80 CP/M Emulator for Windows"
            VALUE "FileVersion", VERSION_STRING_FULL
            VALUE "InternalName", "z80cpmw"
            VALUE "LegalCopyright", "Copyright (C) 2025"
            VALUE "OriginalFilename", "z80cpmw.exe"
            VALUE "ProductName", "z80cpmw"
            VALUE "ProductVersion", VERSION_STRING_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// No ACCELERATORS resource here, on purpose. The table is built at runtime by
// MainWindow::rebuildAccelerators(), because the config decides which shortcuts
// stay with the app and which are released to CP/M. The static table that used
// to live here was never loaded by anything and only misled the reader.
// The shortcut hints in the menu above are the defaults; updateMenuAccelHints()
// rewrites them to match whatever the config actually registers.

// Note: Manifest is auto-generated by linker with common controls dependency (see pch.h)
